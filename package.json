{
	"name": "hyena",
	"version": "0.2.0-alpha.1",
	"private": true,
	"type": "module",
	"description": "A small Mastodon-compatible server built for Cloudflare Workers",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "wrangler dev",
		"build": "wrangler deploy --dry-run --outdir dist",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "npm run typecheck && npm test && npm run test:backup && npm run build",
		"db:migrate": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"deploy": "node scripts/check-deploy.mjs && wrangler deploy",
		"format": "prettier --write src public tests scripts/*.mjs docs/implementation.md docs/operations.md README.md wrangler.jsonc tsconfig.json vitest.config.ts package.json",
		"test:backup": "node --test scripts/test-backup.mjs",
		"provision": "node scripts/provision.mjs",
		"dev:local": "node scripts/dev-local.mjs"
	},
	"dependencies": {
		"@fastify/busboy": "3.2.2",
		"@fedify/fedify": "2.3.6",
		"@fedify/hono": "2.3.6",
		"@fedify/vocab": "2.3.6",
		"@fedify/vocab-runtime": "2.3.6",
		"@js-temporal/polyfill": "0.5.1",
		"@noble/hashes": "2.4.0",
		"@simplewebauthn/server": "14.0.1",
		"hono": "4.13.7",
		"mediabunny": "1.56.1",
		"sanitize-html": "2.17.7"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.1.6",
		"@cloudflare/workers-types": "5.20260908.1",
		"@types/node": "22.20.2",
		"@types/sanitize-html": "2.16.1",
		"@vitest/runner": "4.1.11",
		"@vitest/snapshot": "4.1.11",
		"jsonc-parser": "3.3.1",
		"prettier": "3.9.6",
		"typescript": "7.0.2",
		"vite": "8.2.2",
		"vitest": "4.1.11",
		"wrangler": "4.130.0"
	},
	"overrides": {
		"@opentelemetry/core": "2.8.0",
		"@opentelemetry/resources": "2.8.0",
		"@opentelemetry/sdk-metrics": "2.8.0",
		"@opentelemetry/sdk-trace-base": "2.8.0"
	}
}
