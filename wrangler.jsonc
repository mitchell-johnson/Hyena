{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hyena",
	"account_id": "125d5501f65fb8940fc3c6ce9ebec809",
	"main": "src/index.ts",
	"assets": { "directory": "public", "binding": "ASSETS" },
	"compatibility_date": "2026-09-10",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{ "pattern": "hyena.johnson.fyi", "custom_domain": true },
		{ "pattern": "johnson.fyi/.well-known/webfinger*", "zone_name": "johnson.fyi" },
	],
	"vars": {
		"PUBLIC_ORIGIN": "https://hyena.johnson.fyi",
		"ACCOUNT_DOMAIN": "johnson.fyi",
		"INSTANCE_TITLE": "Hyena",
		"INSTANCE_DESCRIPTION": "A personal home on the fediverse.",
		"MAX_MEDIA_BYTES": "40000000",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hyena",
			"database_id": "f67405fc-934b-42af-8d57-9bd84b639ebc",
			"migrations_dir": "schema",
		},
	],
	"r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "hyena-media" }],
	"queues": {
		"producers": [{ "binding": "JOBS", "queue": "hyena-jobs" }],
		"consumers": [
			{
				"queue": "hyena-jobs",
				"max_batch_size": 10,
				"max_batch_timeout": 1,
				"max_retries": 5,
				"max_concurrency": 2,
				"dead_letter_queue": "hyena-dead-letter",
			},
		],
	},
	"durable_objects": { "bindings": [{ "name": "STREAMS", "class_name": "StreamHub" }] },
	"exports": { "StreamHub": { "type": "durable-object", "storage": "sqlite" } },
	"images": { "binding": "IMAGES" },
	"media": { "binding": "MEDIA" },
	"ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
	"triggers": { "crons": ["* * * * *"] },
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.1,
		"logs": { "enabled": true, "invocation_logs": false },
	},
}
